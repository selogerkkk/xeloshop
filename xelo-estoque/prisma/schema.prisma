generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cotas {
  id             String   @id @default(uuid())
  estoqueId      String
  socioId        String
  percentual     Decimal  @db.Decimal(5, 2)
  valorInvestido Decimal  @db.Decimal(12, 2)
  estoques       estoques @relation(fields: [estoqueId], references: [id], onDelete: Cascade)
  socios         socios   @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@unique([estoqueId, socioId])
}

model distribuicoes_lucro {
  id                 String             @id @default(uuid())
  vendaId            String
  socioId            String
  percentualAplicado Decimal            @db.Decimal(5, 2)
  valor              Decimal            @db.Decimal(12, 2)
  status             StatusDistribuicao @default(PENDENTE)
  dataDistribuicao   DateTime           @default(now())
  socios             socios             @relation(fields: [socioId], references: [id])
  vendas             vendas             @relation(fields: [vendaId], references: [id], onDelete: Cascade)
}

model dividas_ajuste {
  id            String       @id @default(uuid())
  socioId       String
  valorOriginal Decimal      @db.Decimal(12, 2)
  valorPendente Decimal      @db.Decimal(12, 2)
  motivo        String
  referenciaId  String?
  status        StatusDivida @default(ATIVA)
  dataCriacao   DateTime     @default(now())
  dataQuitacao  DateTime?
  socios        socios       @relation(fields: [socioId], references: [id])
}

model entradas {
  id                 String               @id @default(uuid())
  estoqueId          String
  tipo               TipoEntrada
  quantidade         Int
  custoUnitario      Decimal              @db.Decimal(10, 2)
  custoTotal         Decimal              @db.Decimal(12, 2)
  fornecedor         String?
  dataEntrada        DateTime             @default(now())
  estoques           estoques             @relation(fields: [estoqueId], references: [id])
  pagamentos_entrada pagamentos_entrada[]
}

model estoques {
  id                   String        @id @default(uuid())
  produtoId            String
  nome                 String
  tipo                 TipoEstoque
  localFisico          String?
  quantidadeTotal      Int           @default(0)
  quantidadeDisponivel Int           @default(0)
  custoMedio           Decimal       @default(0) @db.Decimal(10, 2)
  valorTotalInvestido  Decimal       @default(0) @db.Decimal(12, 2)
  ativo                Boolean       @default(true)
  criadoEm             DateTime      @default(now())
  atualizadoEm         DateTime      @updatedAt
  cotas                cotas[]
  entradas             entradas[]
  produtos             produtos      @relation(fields: [produtoId], references: [id])
  venda_itens          venda_itens[]
}

model pagamentos_entrada {
  id         String   @id @default(uuid())
  entradaId  String
  socioId    String
  percentual Decimal  @db.Decimal(5, 2)
  valor      Decimal  @db.Decimal(12, 2)
  entradas   entradas @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  socios     socios   @relation(fields: [socioId], references: [id])
}

model produtos {
  id           String     @id @default(uuid())
  nome         String
  linkProduto  String?
  sku          String?    @unique
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  estoques     estoques[]
}

model saques {
  id              String      @id @default(uuid())
  socioId         String
  valor           Decimal     @db.Decimal(12, 2)
  motivo          String?
  status          StatusSaque @default(PENDENTE)
  dataSolicitacao DateTime    @default(now())
  dataPagamento   DateTime?
  socios          socios      @relation(fields: [socioId], references: [id])
}

model socios {
  id                  String                @id @default(uuid())
  nome                String
  tipo                TipoSocio
  cor                 String
  ativo               Boolean               @default(true)
  saldoDisponivel     Decimal               @default(0) @db.Decimal(12, 2)
  saldoPendente       Decimal               @default(0) @db.Decimal(12, 2)
  totalInvestido      Decimal               @default(0) @db.Decimal(12, 2)
  totalRecebido       Decimal               @default(0) @db.Decimal(12, 2)
  totalSacado         Decimal               @default(0) @db.Decimal(12, 2)
  criadoEm            DateTime              @default(now())
  atualizadoEm        DateTime              @updatedAt
  cotas               cotas[]
  distribuicoes_lucro distribuicoes_lucro[]
  dividas_ajuste      dividas_ajuste[]
  pagamentos_entrada  pagamentos_entrada[]
  saques              saques[]
}

model usuarios {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nome         String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model venda_itens {
  id            String   @id @default(uuid())
  vendaId       String
  estoqueId     String
  quantidade    Int
  precoUnitario Decimal  @db.Decimal(10, 2)
  custoUnitario Decimal  @db.Decimal(10, 2)
  lucroTotal    Decimal  @db.Decimal(12, 2)
  estoques      estoques @relation(fields: [estoqueId], references: [id])
  vendas        vendas   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
}

model vendas {
  id                  String                @id @default(uuid())
  canal               String
  receitaTotal        Decimal               @db.Decimal(12, 2)
  custoTotal          Decimal               @db.Decimal(12, 2)
  lucroTotal          Decimal               @db.Decimal(12, 2)
  status              StatusVenda           @default(CONCLUIDA)
  dataVenda           DateTime              @default(now())
  dataCancelamento    DateTime?
  motivoCancelamento  String?
  distribuicoes_lucro distribuicoes_lucro[]
  venda_itens         venda_itens[]
}

enum StatusDistribuicao {
  PENDENTE
  LIBERADO
  RETIDO
}

enum StatusDivida {
  ATIVA
  QUITADA
}

enum StatusSaque {
  PENDENTE
  APROVADO
  PAGO
  CANCELADO
}

enum StatusVenda {
  CONCLUIDA
  CANCELADA
}

enum TipoEntrada {
  COMPRA
  REPOSICAO
  TRANSFERENCIA
  AJUSTE
}

enum TipoEstoque {
  INDIVIDUAL
  POOL
}

enum TipoSocio {
  PESSOA
  EMPRESA
}
